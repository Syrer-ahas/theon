# Never add real keys to source control. Configure these in Vercel Project Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_AUDIENCE_ID=your_resend_audience_id

# Required for persistent credits, bans, and dashboard user management on Vercel/Upstash.
KV_REST_API_URL=https://your-redis-endpoint.upstash.io
KV_REST_API_TOKEN=your_redis_rest_token

# Server-side allowlist for the account-management dashboard.
ADMIN_EMAIL=your-admin@gmail.com

# Stripe subscription billing. Keep all secrets in Vercel environment variables.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxx
STRIPE_PRICE_PREMIUM=price_xxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxx
PUBLIC_SITE_URL=https://tacticalweb.online
