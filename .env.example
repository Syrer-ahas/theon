# Never add real keys to source control. Configure these in Vercel Project Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_AUDIENCE_ID=your_resend_audience_id

# Optional but recommended for persistent, atomic credit balances on Vercel/Upstash.
KV_REST_API_URL=https://your-redis-endpoint.upstash.io
KV_REST_API_TOKEN=your_redis_rest_token

# Server-side allowlist for the account-management dashboard.
ADMIN_EMAIL=your-admin@gmail.com
