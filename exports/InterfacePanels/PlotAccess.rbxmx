    <Item class="LocalScript">
      <Properties>
        <string name="Name">GuiController</string>
        <ProtectedString name="Source">do
    local gui = script.Parent
    local data = game:GetService("HttpService"):JSONDecode([==[{"name":"PlotAccess","canvas":{"width":4193,"height":2952},"parts":[{"name":"Panel","kind":"panel","sourceId":"PlotAccess","x":0,"y":0,"width":4193,"height":2952,"file":"PlotAccess/Panel.png","textureWidth":4096,"textureHeight":2884,"assetId":"rbxassetid://84644839712594"},{"name":"CloseButton","kind":"close","sourceId":"CLOSEBTN","x":3783,"y":0,"width":410,"height":444,"file":"PlotAccess/CloseButton.png","textureWidth":946,"textureHeight":1024,"assetId":"rbxassetid://117812010302663"},{"name":"Button1","kind":"button","sourceId":"BUTTON","x":197,"y":537,"width":3800,"height":537,"file":"PlotAccess/Button1.png","textureWidth":4096,"textureHeight":579,"assetId":"rbxassetid://119728788274447"}],"verification":{"meanChannelError":0.0002914887139124808,"maxError":1.3402229911572618,"pixelsAbove3":0,"pixels":704000}}]==])
    gui:SetAttribute("DesignWidth", data.canvas.width)
    gui:SetAttribute("DesignHeight", data.canvas.height)
    for _, part in ipairs(data.parts) do
        local node = gui:WaitForChild(part.name)
        node:SetAttribute("DesignX", part.x)
        node:SetAttribute("DesignY", part.y)
        node:SetAttribute("DesignWidth", part.width)
        node:SetAttribute("DesignHeight", part.height)
        node:SetAttribute("ExportWidth", part.textureWidth)
        node:SetAttribute("ExportHeight", part.textureHeight)
        node:SetAttribute("FigmaLayer", part.sourceId)
    end
end
local gui = script.Parent
local cameraConnection

local function layout()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local viewport = camera.ViewportSize
	if viewport.X &lt;= 0 or viewport.Y &lt;= 0 then return end
	local width = gui:GetAttribute("DesignWidth")
	local height = gui:GetAttribute("DesignHeight")
	local scale = math.min(viewport.X * 0.84 / width, viewport.Y * 0.82 / height, 960 / 4193)
	for _, node in gui:GetChildren() do
		if node:IsA("GuiObject") and node:GetAttribute("DesignX") ~= nil then
			local x, y = node:GetAttribute("DesignX"), node:GetAttribute("DesignY")
			local w, h = node:GetAttribute("DesignWidth"), node:GetAttribute("DesignHeight")
			node.Position = UDim2.new(0.5, (x + w / 2 - width / 2) * scale, 0.5, (y + h / 2 - height / 2) * scale)
			node.Size = UDim2.fromOffset(w * scale, h * scale)
		end
	end
end

local function bindCamera()
	if cameraConnection then cameraConnection:Disconnect() end
	local camera = workspace.CurrentCamera
	if camera then cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(layout) end
	layout()
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
bindCamera()

local close = gui:WaitForChild("CloseButton")
close.Activated:Connect(function()
	gui.Enabled = false
end)

local requested = gui:WaitForChild("ButtonActivated")
for _, node in gui:GetChildren() do
	if node:IsA("ImageButton") and node ~= close then
		node.Activated:Connect(function()
			if gui.Name == "Index" then
				gui:SetAttribute("SelectedCategory", node.Name:gsub("Button$", ""))
			end
			requested:Fire(node.Name)
		end)
	end
end

script.Destroying:Connect(function()
	if cameraConnection then cameraConnection:Disconnect() end
end)
</ProtectedString>
      </Properties>
